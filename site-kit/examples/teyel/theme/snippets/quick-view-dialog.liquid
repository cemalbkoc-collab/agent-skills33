<dialog class="dialog dialog--quick" id="quick-view" aria-label="{{ 'product.quick_view' | t }}">
  <button type="button" class="dialog__close" data-dialog-close aria-label="{{ 'general.close' | t }}">{% render 'icon', name: 'close' %}</button>
  <div class="dialog__body" data-quick-view-body aria-live="polite">
    <p class="dialog__loading">{{ 'general.loading' | t }}</p>
  </div>
</dialog>
