{%- comment -%}
  Tek tip çizgi ikon seti. Kullanım: {% render 'icon', name: 'bag' %}
{%- endcomment -%}
<svg class="icon icon-{{ name }}" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'bag' -%}
      <path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="3.5"/><path d="M5 20c1-4 4-5.5 7-5.5s6 1.500 7 5.500"/>
    {%- when 'heart' -%}
      <path d="M12 20s-7-4.500-7-10a4 4 0 0 1 7-2.500A4 4 0 0 1 19 10c0 5.500-7 10-7 10z"/>
    {%- when 'menu' -%}
      <path d="M4 8h16M4 16h16"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'arrow' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'chevron' -%}
      <path d="M6 9l6 6 6-6"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'ruler' -%}
      <path d="M3 9h18v6H3z"/><path d="M7 9v3M11 9v3M15 9v3M19 9v2"/>
    {%- when 'truck' -%}
      <path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.500" r="1.500"/><circle cx="17" cy="17.500" r="1.500"/>
    {%- when 'card' -%}
      <rect x="3" y="6" width="18" height="12"/><path d="M3 10h18M7 15h4"/>
    {%- when 'return' -%}
      <path d="M4 9h11a5 5 0 0 1 0 10H8"/><path d="M8 5L4 9l4 4"/>
    {%- when 'eye' -%}
      <path d="M2.500 12s3.500-6 9.500-6 9.500 6 9.500 6-3.500 6-9.500 6-9.500-6-9.500-6z"/><circle cx="12" cy="12" r="2.500"/>
    {%- when 'filter' -%}
      <path d="M4 7h16M7 12h10M10 17h4"/>
    {%- when 'star' -%}
      <path d="M12 4l2.400 5 5.600.700-4.100 3.800 1.100 5.500L12 16.300 7 19l1.100-5.500L4 9.700 9.600 9z" fill="currentColor" stroke="none"/>
    {%- when 'needle' -%}
      <path d="M3 21L15 9" stroke-dasharray="3.500 3"/><ellipse cx="18.500" cy="5.500" rx="3.500" ry="1.800" transform="rotate(-45 18.500 5.500)"/>
    {%- when 'check' -%}
      <path d="M5 12.500l4.500 4.500L19 7.500"/>
    {%- when 'instagram' -%}
      <rect x="4" y="4" width="16" height="16" rx="4"/><circle cx="12" cy="12" r="3.500"/><circle cx="16.800" cy="7.200" r=".600" fill="currentColor"/>
  {%- endcase -%}
</svg>
