{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": { "type": "title", "settings": { "show_vendor": false } },
        "price": { "type": "price", "settings": { "show_installments": true } },
        "picker": { "type": "variant_picker", "settings": {} },
        "buy": { "type": "buy_buttons", "settings": { "show_dynamic_checkout": false } },
        "desc": { "type": "description", "settings": {} },
        "material": { "type": "accordion", "settings": { "heading": "Malzeme", "source": "material", "open": false } },
        "care": { "type": "accordion", "settings": { "heading": "Bakım", "source": "care", "open": false } },
        "shipping": {
          "type": "accordion",
          "settings": {
            "heading": "Kargo ve iade",
            "source": "text",
            "text": "<p>Siparişin 1-3 iş günü içinde kargoya verilir. 1.500 TL üzeri siparişlerde kargo ücretsizdir. Ürünü teslim aldıktan sonra 14 gün içinde, kullanılmamış ve etiketli olarak iade edebilirsin.</p>",
            "open": false
          }
        },
        "look": { "type": "complete_look", "settings": { "heading": "Kombini tamamla" } }
      },
      "block_order": ["title", "price", "picker", "buy", "desc", "material", "care", "shipping", "look"]
    },
    "related": {
      "type": "product-recommendations",
      "settings": { "heading": "Kombini tamamla", "limit": 4, "intent": "related" }
    },
    "recent": {
      "type": "recently-viewed",
      "settings": { "heading": "Son baktıkların", "limit": 4 }
    }
  },
  "order": ["main", "related", "recent"]
}
