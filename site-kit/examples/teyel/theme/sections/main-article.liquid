<article class="article">
  <header class="page textpage--narrow article__head">
    <p class="label"><a href="{{ blog.url }}">{{ blog.title }}</a> · {{ article.published_at | date: '%d.%m.%Y' }}</p>
    <h1 class="h1">{{ article.title }}</h1>
  </header>
  {%- if article.image -%}
    <div class="article__hero">
      <img src="{{ article.image | image_url: width: 1600 }}" srcset="{{ article.image | image_url: width: 800 }} 800w, {{ article.image | image_url: width: 1600 }} 1600w, {{ article.image | image_url: width: 2400 }} 2400w" sizes="100vw" width="{{ article.image.width }}" height="{{ article.image.height }}" loading="eager" fetchpriority="high" alt="{{ article.image.alt | escape }}">
    </div>
  {%- endif -%}
  <div class="page textpage--narrow rte article__body">{{ article.content }}</div>
  {%- if section.settings.collection != blank -%}
    <section class="page section" aria-labelledby="art-shop">
      <div class="section__head"><h2 class="h2" id="art-shop">{{ section.settings.heading }}</h2></div>
      <ul class="grid" role="list">
        {%- for product in section.settings.collection.products limit: 4 -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    </section>
  {%- endif -%}
  <script type="application/ld+json">{{ article | structured_data }}</script>
</article>

{% schema %}
{
  "name": "Lookbook yazısı",
  "settings": [
    { "type": "text", "id": "heading", "label": "Ürünler başlığı", "default": "Bu bakıştaki parçalar" },
    { "type": "collection", "id": "collection", "label": "Gösterilecek koleksiyon" }
  ]
}
{% endschema %}
