{%- comment -%} Hem şifre sıfırlama hem hesap etkinleştirme için kullanılır. {%- endcomment -%}
<section class="page authpage">
  <div class="authpage__card">
    {%- if section.settings.mode == 'activate' -%}
      <h1 class="h1">{{ 'customer.activate_title' | t }}</h1>
      {%- form 'activate_customer_password', class: 'authpage__form', id: 'activate-form' -%}
        {%- if form.errors -%}<p class="form-note form-note--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <p><label for="act-pass">{{ 'customer.password' | t }}</label><input class="field" id="act-pass" type="password" name="customer[password]" autocomplete="new-password" required></p>
        <p><label for="act-pass2">{{ 'customer.password_confirm' | t }}</label><input class="field" id="act-pass2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></p>
        <button type="submit" class="btn-solid">{{ 'customer.activate' | t }}</button>
      {%- endform -%}
    {%- else -%}
      <h1 class="h1">{{ 'customer.reset_title' | t }}</h1>
      {%- form 'reset_customer_password', class: 'authpage__form', id: 'reset-form' -%}
        {%- if form.errors -%}<p class="form-note form-note--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <p><label for="res-pass">{{ 'customer.password' | t }}</label><input class="field" id="res-pass" type="password" name="customer[password]" autocomplete="new-password" required></p>
        <p><label for="res-pass2">{{ 'customer.password_confirm' | t }}</label><input class="field" id="res-pass2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></p>
        <button type="submit" class="btn-solid">{{ 'customer.reset' | t }}</button>
      {%- endform -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Şifre",
  "settings": [
    { "type": "select", "id": "mode", "label": "Tür", "options": [ { "value": "reset", "label": "Şifre sıfırlama" }, { "value": "activate", "label": "Hesap etkinleştirme" } ], "default": "reset" }
  ]
}
{% endschema %}
