<footer class="footer">
  <div class="page">
    <div class="stitch" aria-hidden="true"></div>
    <div class="footer__top">
      <div class="footer__brand">
        <p class="footer__wordmark">{% render 'icon', name: 'needle' %}{{ shop.name }}</p>
        {%- if section.settings.tagline != blank -%}
          <p class="footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}
        {%- if section.settings.show_newsletter -%}
          {%- form 'customer', class: 'inline-form', id: 'footer-newsletter' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="label" for="footer-newsletter-email">{{ 'newsletter.label' | t }}</label>
            <div class="inline-form__row">
              <input class="field" id="footer-newsletter-email" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}" required>
              <button type="submit" class="btn-solid btn-solid--small">{{ 'newsletter.submit' | t }}</button>
            </div>
            {%- if form.posted_successfully? -%}
              <p class="form-note form-note--ok" role="status">{{ 'newsletter.success' | t }}</p>
            {%- endif -%}
            {%- if form.errors -%}
              <p class="form-note form-note--error" role="alert">{{ form.errors | default_errors }}</p>
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <nav class="footer__col" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
              <h2 class="label">{{ block.settings.heading }}</h2>
              <ul role="list">
                {%- for link in linklists[block.settings.menu].links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </nav>
          {%- when 'text' -%}
            <div class="footer__col" {{ block.shopify_attributes }}>
              <h2 class="label">{{ block.settings.heading }}</h2>
              <div class="rte">{{ block.settings.text }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
    <div class="footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
      <ul class="footer__social" role="list">
        {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" rel="noopener" target="_blank">Instagram</a></li>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" rel="noopener" target="_blank">TikTok</a></li>{%- endif -%}
        {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" rel="noopener" target="_blank">YouTube</a></li>{%- endif -%}
      </ul>
      {%- if section.settings.show_payment -%}
        <ul class="footer__pay" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'footer__pay-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Alt bölüm",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Slogan", "default": "Önce teyel, sonra dikiş." },
    { "type": "checkbox", "id": "show_newsletter", "label": "Bülten kayıt alanını göster", "default": true },
    { "type": "checkbox", "id": "show_payment", "label": "Ödeme simgelerini göster", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menü sütunu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Başlık", "default": "Mağaza" },
        { "type": "link_list", "id": "menu", "label": "Menü", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Yazı sütunu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Başlık", "default": "Atölye" },
        { "type": "richtext", "id": "text", "label": "Metin", "default": "<p>Hafta içi 10.00-18.00 arası yazabilirsin.</p>" }
      ]
    }
  ],
  "max_blocks": 4,
  "default": {
    "blocks": [ { "type": "menu" }, { "type": "text" } ]
  }
}
{% endschema %}
