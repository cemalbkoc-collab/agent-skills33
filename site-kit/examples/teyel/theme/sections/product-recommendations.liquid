<section class="section" data-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}" aria-labelledby="rec-{{ section.id }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="page">
      <div class="section__head">
        <h2 class="h2" id="rec-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      <ul class="grid" role="list">
        {%- for product in recommendations.products -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Önerilen ürünler",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Kombini tamamla" },
    { "type": "range", "id": "limit", "label": "Ürün sayısı", "min": 2, "max": 8, "step": 1, "default": 4 },
    {
      "type": "select", "id": "intent", "label": "Öneri türü",
      "info": "\"Tamamlayıcı\" için Shopify Search & Discovery uygulamasında ürün eşleştirmesi yapmanız gerekir.",
      "options": [ { "value": "related", "label": "Benzer ürünler" }, { "value": "complementary", "label": "Tamamlayıcı ürünler" } ],
      "default": "related"
    }
  ]
}
{% endschema %}
