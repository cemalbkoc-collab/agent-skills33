<section class="page notfound">
  <p class="notfound__code" aria-hidden="true">404</p>
  <div class="stitch notfound__stitch" aria-hidden="true"></div>
  <h1 class="h1">{{ section.settings.heading }}</h1>
  <p class="muted">{{ section.settings.text }}</p>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form notfound__search">
    <label class="visually-hidden" for="nf-search">{{ 'general.search' | t }}</label>
    {% render 'icon', name: 'search' %}
    <input class="search-form__input" id="nf-search" type="search" name="q" placeholder="{{ 'search.placeholder' | t }}">
  </form>
  <a class="link-stitch" href="{{ routes.root_url }}">{{ 'general.back_home' | t }}{% render 'icon', name: 'arrow' %}</a>
</section>

{% schema %}
{
  "name": "Sayfa bulunamadı",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Bu dikiş sökülmüş." },
    { "type": "text", "id": "text", "label": "Metin", "default": "Aradığın sayfa taşınmış ya da hiç olmamış. Aramayı dene ya da ana sayfaya dön." }
  ]
}
{% endschema %}
