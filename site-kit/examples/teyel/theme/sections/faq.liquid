<section class="page faq" aria-labelledby="faq-{{ section.id }}">
  <div class="faq__head">
    <h1 class="h1" id="faq-{{ section.id }}">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<div class="rte muted">{{ section.settings.text }}</div>{%- endif -%}
  </div>
  <div class="faq__list">
    {%- for block in section.blocks -%}
      {%- if block.type == 'group' -%}
        <h2 class="label faq__group" {{ block.shopify_attributes }}>{{ block.settings.title }}</h2>
      {%- else -%}
        <details class="accordion" {{ block.shopify_attributes }}>
          <summary><span>{{ block.settings.question }}</span>{% render 'icon', name: 'plus' %}</summary>
          <div class="accordion__body rte">{{ block.settings.answer }}</div>
        </details>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- assign first = true -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'question' -%}
            {%- unless first -%},{%- endunless -%}
            { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }
            {%- assign first = false -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "Sık sorulan sorular",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Sık sorulan sorular" },
    { "type": "richtext", "id": "text", "label": "Metin" }
  ],
  "blocks": [
    { "type": "group", "name": "Grup başlığı", "settings": [ { "type": "text", "id": "title", "label": "Başlık", "default": "Sipariş" } ] },
    { "type": "question", "name": "Soru", "settings": [ { "type": "text", "id": "question", "label": "Soru", "default": "Siparişim ne zaman kargoya verilir?" }, { "type": "richtext", "id": "answer", "label": "Cevap", "default": "<p>1-3 iş günü içinde.</p>" } ] }
  ],
  "presets": [ { "name": "Sık sorulan sorular" } ]
}
{% endschema %}
