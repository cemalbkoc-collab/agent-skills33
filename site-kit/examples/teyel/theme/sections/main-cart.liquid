{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign progress = 100
  if threshold > 0 and remaining > 0
    assign progress = cart.total_price | times: 100 | divided_by: threshold
  endif
-%}
<section class="page cartpage">
  <h1 class="h1">{{ 'cart.title' | t }}</h1>
  {%- if cart.item_count == 0 -%}
    <div class="empty-state">
      <p class="h3">{{ 'cart.empty' | t }}</p>
      <a class="link-stitch" href="{{ routes.all_products_collection_url }}">{{ 'cart.empty_cta' | t }}{% render 'icon', name: 'arrow' %}</a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" class="cartpage__grid" id="cart-form">
      <div>
        {%- if threshold > 0 -%}
          <div class="shipbar">
            <p class="shipbar__text">
              {%- if remaining > 0 -%}{{ 'cart.free_shipping_remaining_html' | t: amount: '' }}<strong>{{ remaining | money }}</strong>{%- else -%}{{ 'cart.free_shipping_reached' | t }}{%- endif -%}
            </p>
            <div class="shipbar__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ progress }}" aria-label="{{ 'cart.free_shipping_progress' | t }}"><span class="shipbar__fill" style="width: {{ progress }}%"></span></div>
          </div>
        {%- endif -%}
        <ul class="cart-lines" role="list">
          {%- for item in cart.items -%}
            <li class="cart-line cart-line--page">
              <a class="cart-line__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                {%- if item.image -%}<img src="{{ item.image | image_url: width: 300 }}" width="150" height="150" loading="lazy" alt="">{%- endif -%}
              </a>
              <div class="cart-line__info">
                <a class="cart-line__title" href="{{ item.url }}">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="cart-line__variant">{{ item.variant.title }}</p>{%- endunless -%}
                <div class="cart-line__row">
                  <p>
                    <label class="visually-hidden" for="qty-{{ forloop.index }}">{{ 'cart.quantity' | t }}: {{ item.product.title | escape }}</label>
                    <input class="field field--qty" id="qty-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">
                  </p>
                  <span class="cart-line__price">{{ item.final_line_price | money }}</span>
                </div>
                <a class="cart-line__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        <button type="submit" name="update" class="btn-line cartpage__update">{{ 'cart.update' | t }}</button>
      </div>
      <aside class="cartpage__summary" aria-label="{{ 'cart.summary' | t }}">
        {%- if section.settings.show_note -%}
          <p>
            <label for="cart-note">{{ 'cart.note' | t }}</label>
            <textarea class="field field--area" id="cart-note" name="note" rows="3">{{ cart.note }}</textarea>
          </p>
        {%- endif -%}
        <div class="cart-total"><span>{{ 'cart.subtotal' | t }}</span><strong>{{ cart.total_price | money }}</strong></div>
        <p class="fine">{{ 'cart.shipping_note' | t }}</p>
        <button type="submit" name="checkout" class="btn-solid">{{ 'cart.checkout' | t }}</button>
        {%- if section.settings.trust_text != blank -%}
          <div class="rte fine">{{ section.settings.trust_text }}</div>
        {%- endif -%}
      </aside>
    </form>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Sepet",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "Sipariş notu alanını göster", "default": true },
    { "type": "richtext", "id": "trust_text", "label": "Ödeme altındaki bilgi", "default": "<p>Kartla 9 taksite kadar ya da kapıda ödeme. Güvenli ödeme altyapısı.</p>" }
  ]
}
{% endschema %}
