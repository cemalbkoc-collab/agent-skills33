{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.limit
-%}
<section class="section" aria-labelledby="fc-{{ section.id }}">
  <div class="page">
    <div class="section__head" data-reveal>
      <h2 class="h2" id="fc-{{ section.id }}">{{ section.settings.heading | default: collection.title }}</h2>
      {%- if collection != blank -%}
        <a class="label section__more" href="{{ collection.url }}">{{ 'collection.products_count' | t: count: collection.products_count }} · {{ 'general.view_all' | t }}</a>
      {%- endif -%}
    </div>
    {%- if section.settings.layout == 'rail' -%}
      <ul class="rail" role="list" tabindex="0" aria-label="{{ section.settings.heading | default: collection.title | escape }}">
        {%- for product in collection.products limit: limit -%}
          <li class="rail__item">{% render 'product-card', product: product, sizes: '(min-width: 990px) 22vw, 62vw' %}</li>
        {%- else -%}
          {%- for i in (1..4) -%}
            <li class="rail__item">{{ 'product-1' | placeholder_svg_tag: 'card__img card__img--placeholder' }}</li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>
    {%- else -%}
      <ul class="grid{% if section.settings.layout == 'feature' %} grid--feature{% endif %}" role="list">
        {%- for product in collection.products limit: limit -%}
          <li data-reveal>{% render 'product-card', product: product %}</li>
        {%- else -%}
          {%- for i in (1..4) -%}
            <li>{{ 'product-1' | placeholder_svg_tag: 'card__img card__img--placeholder' }}</li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Öne çıkan koleksiyon",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "info": "Boş bırakılırsa koleksiyon adı kullanılır." },
    { "type": "collection", "id": "collection", "label": "Koleksiyon" },
    { "type": "range", "id": "limit", "label": "Ürün sayısı", "min": 3, "max": 12, "step": 1, "default": 8 },
    {
      "type": "select", "id": "layout", "label": "Düzen",
      "options": [
        { "value": "grid", "label": "Izgara" },
        { "value": "rail", "label": "Yatay kaydırma" },
        { "value": "feature", "label": "Bir büyük, dört küçük" }
      ],
      "default": "grid"
    }
  ],
  "presets": [ { "name": "Öne çıkan koleksiyon" } ]
}
{% endschema %}
