<section class="services" aria-label="{{ section.settings.label | escape }}">
  <div class="page">
    <ul class="services__list" role="list">
      {%- for block in section.blocks -%}
        <li class="services__item" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon %}
          <div>
            <h3 class="services__title">{{ block.settings.title }}</h3>
            <p class="muted">{{ block.settings.text }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Hizmet şeridi",
  "settings": [
    { "type": "text", "id": "label", "label": "Bölüm adı (ekran okuyucular için)", "default": "Kargo, ödeme ve iade" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Madde",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "İkon",
          "options": [
            { "value": "truck", "label": "Kargo" }, { "value": "card", "label": "Kart" },
            { "value": "return", "label": "İade" }, { "value": "ruler", "label": "Ölçü" }, { "value": "needle", "label": "İğne" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Başlık", "default": "1-3 iş gününde kargoda" },
        { "type": "text", "id": "text", "label": "Açıklama", "default": "1.500 TL üzeri siparişlerde kargo bizden." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [ { "name": "Hizmet şeridi", "blocks": [ { "type": "item" }, { "type": "item" }, { "type": "item" } ] } ]
}
{% endschema %}
