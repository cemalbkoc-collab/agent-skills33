<section class="page contact">
  <div class="contact__intro">
    <h1 class="h1">{{ section.settings.heading | default: page.title }}</h1>
    <div class="rte muted">{{ section.settings.text }}</div>
    <dl class="contact__facts">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}><dt class="label">{{ block.settings.label }}</dt><dd>{{ block.settings.value }}</dd></div>
      {%- endfor -%}
    </dl>
  </div>
  {%- form 'contact', class: 'contact__form', id: 'contact-form' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-note form-note--ok" role="status">{{ 'contact.success' | t }}</p>
    {%- endif -%}
    {%- if form.errors -%}
      <p class="form-note form-note--error" role="alert">{{ form.errors | default_errors }}</p>
    {%- endif -%}
    <p><label for="contact-name">{{ 'contact.name' | t }}</label><input class="field" id="contact-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}" required></p>
    <p><label for="contact-email">{{ 'contact.email' | t }}</label><input class="field" id="contact-email" type="email" name="contact[email]" autocomplete="email" value="{{ form.email }}" required></p>
    <p><label for="contact-phone">{{ 'contact.phone' | t }}</label><input class="field" id="contact-phone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></p>
    <p><label for="contact-order">{{ 'contact.order' | t }}</label><input class="field" id="contact-order" type="text" name="contact[siparis]"></p>
    <p class="contact__wide"><label for="contact-body">{{ 'contact.message' | t }}</label><textarea class="field field--area" id="contact-body" name="contact[body]" rows="5" required>{{ form.body }}</textarea></p>
    <p class="fine contact__wide">{{ 'contact.kvkk' | t }}</p>
    <button type="submit" class="btn-solid">{{ 'contact.submit' | t }}</button>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "İletişim formu",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık" },
    { "type": "richtext", "id": "text", "label": "Metin", "default": "<p>Beden, sipariş ya da iade, ne olursa yaz. Hafta içi bir iş günü içinde dönüyoruz.</p>" }
  ],
  "blocks": [
    { "type": "fact", "name": "Bilgi satırı", "settings": [ { "type": "text", "id": "label", "label": "Etiket", "default": "E-posta" }, { "type": "text", "id": "value", "label": "Değer", "default": "merhaba@teyel.example" } ] }
  ],
  "presets": [ { "name": "İletişim formu" } ]
}
{% endschema %}
