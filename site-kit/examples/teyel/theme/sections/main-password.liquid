<section class="drop drop--header password">
  <div class="drop__inner page">
    <div class="drop__text">
      <p class="label">{{ shop.name }}</p>
      <h1 class="drop__title">{{ section.settings.heading }}</h1>
      {%- if shop.password_message != blank -%}<p class="drop__sub">{{ shop.password_message }}</p>{%- endif -%}
      <div class="drop__actions">
        {%- form 'customer', class: 'drop__form', id: 'password-signup' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,prelaunch">
          <label class="visually-hidden" for="pw-email">{{ 'newsletter.label' | t }}</label>
          <input class="drop__input" id="pw-email" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'newsletter.placeholder' | t }}" required>
          <button type="submit" class="drop__btn">{{ 'drop.notify' | t }}</button>
          {%- if form.posted_successfully? -%}<p class="drop__note" role="status">{{ 'newsletter.success' | t }}</p>{%- endif -%}
        {%- endform -%}
      </div>
      <details class="password__owner">
        <summary class="label">{{ 'password.owner' | t }}</summary>
        {%- form 'storefront_password', class: 'drop__form', id: 'storefront-password' -%}
          {%- if form.errors -%}<p class="drop__note" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
          <label class="visually-hidden" for="pw-pass">{{ 'customer.password' | t }}</label>
          <input class="drop__input" id="pw-pass" type="password" name="password" autocomplete="current-password" placeholder="{{ 'customer.password' | t }}">
          <button type="submit" class="drop__btn">{{ 'password.enter' | t }}</button>
        {%- endform -%}
      </details>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Açılış öncesi", "settings": [ { "type": "text", "id": "heading", "label": "Başlık", "default": "Yakında" } ] }
{% endschema %}
