<section class="section" data-recently-viewed data-limit="{{ section.settings.limit }}" aria-labelledby="rvw-{{ section.id }}" hidden>
  <div class="page">
    <div class="section__head">
      <h2 class="h2" id="rvw-{{ section.id }}">{{ section.settings.heading }}</h2>
    </div>
    <ul class="grid" role="list" data-recently-list></ul>
  </div>
</section>

{% schema %}
{
  "name": "Son bakılanlar",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Son baktıkların" },
    { "type": "range", "id": "limit", "label": "Ürün sayısı", "min": 2, "max": 8, "step": 1, "default": 4 }
  ],
  "presets": [ { "name": "Son bakılanlar" } ]
}
{% endschema %}
