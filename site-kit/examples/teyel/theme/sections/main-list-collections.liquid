<section class="page section">
  <h1 class="h1">{{ section.settings.heading }}</h1>
  <ul class="grid collections-grid" role="list">
    {%- for collection in collections -%}
      <li>
        <a class="card" href="{{ collection.url }}">
          <div class="card__media card__link">
            {%- assign img = collection.featured_image | default: collection.products.first.featured_media -%}
            {%- if img -%}<img class="card__img" src="{{ img | image_url: width: 600 }}" width="600" height="600" loading="lazy" alt="">{%- endif -%}
          </div>
          <div class="card__row"><h2 class="card__title">{{ collection.title }}</h2><span class="label">{{ collection.products_count }}</span></div>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{ "name": "Tüm koleksiyonlar", "settings": [ { "type": "text", "id": "heading", "label": "Başlık", "default": "Koleksiyonlar" } ] }
{% endschema %}
