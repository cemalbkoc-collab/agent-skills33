<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
    <link rel="canonical" href="{{ canonical_url }}">
    {%- style -%}
      :root { --paper: {{ settings.color_background }}; --tulle: {{ settings.color_surface }}; --ink: {{ settings.color_text }}; --lead: {{ settings.color_muted }}; --line: {{ settings.color_line }}; --cobalt: {{ settings.color_accent }}; --on-cobalt: {{ settings.color_on_accent }}; --drop-bg: {{ settings.color_drop_background }}; --drop-fg: {{ settings.color_drop_text }}; --page-max: {{ settings.page_width }}px; }
    {%- endstyle -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main id="icerik">{{ content_for_layout }}</main>
  </body>
</html>
